# =============================================================================
# AI HUMANOID PRESENTATION ROBOT - Environment Configuration
# =============================================================================
# Copy this file to .env (backend) and .env.local (frontend) and fill in values.
# NEVER commit .env or .env.local files.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-long-random-secret-key
LOG_LEVEL=INFO

# --- Database ---
# SQLite (development):
DATABASE_URL=sqlite:///./data/robot.db
# PostgreSQL (production example):
# DATABASE_URL=postgresql://user:password@localhost:5432/head_movement

# --- Hardware / ESP32 ---
# Connection type: mock | serial | wifi | websocket
ESP32_CONNECTION_TYPE=mock
# Serial port (when using serial):
ESP32_PORT=COM3
# Wi-Fi / HTTP host and port (when using wifi or websocket):
ESP32_HOST=192.168.1.100
ESP32_WIFI_PORT=80
ESP32_WEBSOCKET_PORT=81
# Baud rate for serial connection:
ESP32_BAUD_RATE=115200

# --- Servo Configuration ---
PAN_MIN_ANGLE=0
PAN_MAX_ANGLE=180
PAN_CENTER_ANGLE=90
PAN_SPEED=50
TILT_MIN_ANGLE=30
TILT_MAX_ANGLE=150
TILT_CENTER_ANGLE=90
TILT_SPEED=50

# --- Camera ---
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# --- File Storage ---
DATA_DIRECTORY=./data
MODEL_DIRECTORY=./data/models
DATASET_DIRECTORY=./data/datasets
RECORDINGS_DIRECTORY=./data/recordings
MAX_UPLOAD_SIZE_MB=100

# --- Speech Recognition ---
# Provider: none | whisper | google | azure
SPEECH_PROVIDER=none
# Whisper model size: tiny | base | small | medium | large
WHISPER_MODEL=base
# Google Cloud Speech credentials (when using google):
GOOGLE_SPEECH_CREDENTIALS=
# Azure Speech key/region (when using azure):
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- NLP ---
# Provider: rule_based | openai | local
NLP_PROVIDER=rule_based
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Head Tracking ---
# Sensitivity multipliers (human range → robot range)
HEAD_TRACKING_YAW_SENSITIVITY=0.5
HEAD_TRACKING_PITCH_SENSITIVITY=0.5
HEAD_TRACKING_DEAD_ZONE=3.0
HEAD_TRACKING_SMOOTHING_FACTOR=0.3
HEAD_TRACKING_MAX_SPEED=30

# --- Audience Tracking ---
AUDIENCE_TARGET_DURATION_SECONDS=5
AUDIENCE_SWITCH_COOLDOWN_SECONDS=3
AUDIENCE_MAX_FACES=10

# --- Gesture Recognition ---
GESTURE_CONFIDENCE_THRESHOLD=0.85
GESTURE_COOLDOWN_SECONDS=1.0
GESTURE_MIN_DURATION_FRAMES=10

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/live
VITE_APP_TITLE=AI Presentation Robot

# --- CORS ---
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
